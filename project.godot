; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Scene Manager"
run/main_scene="uid://blee3apqqctiw"
config/features=PackedStringArray("4.6")
boot_splash/show_image=false
boot_splash/stretch_mode=0
boot_splash/use_filter=false
config/icon="res://icon.svg"

[autoload]

Scenes="*res://scene_manager_data/scenes.gd"
SceneManager="*res://addons/scene_manager/scene_manager.tscn"
DLogger="*uid://dk8w65jl35vbd"

[debug]

gdscript/warnings/unsafe_property_access=2
gdscript/warnings/unsafe_method_access=2
gdscript/warnings/unsafe_cast=2
gdscript/warnings/unsafe_call_argument=2
gdscript/warnings/unsafe_void_return=2
d_logger/enable_console_log=false
d_logger/min_log_level=0
d_logger/enable_file_log=false
d_logger/log_file_path="user://debug.log"

[display]

window/size/resizable=false

[editor_plugins]

enabled=PackedStringArray("res://addons/d_logger/plugin.cfg", "res://addons/scene_manager/plugin.cfg")

[filesystem]

import/blender/enabled=false

[input]

test_signal0={
"deadzone": 0.2,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":4194332,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
]
}

[physics]

common/enable_pause_aware_picking=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/default_environment="res://default_env.tres"
